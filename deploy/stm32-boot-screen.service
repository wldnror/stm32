[Unit]
Description=Early STM32 OLED startup screen
DefaultDependencies=no
RequiresMountsFor=/home/user/stm32
Before=stm32.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
Group=user
UMask=0002
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=stm32-boot
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
StandardOutput=append:/run/stm32-boot.log
StandardError=inherit
Nice=-5
ExecStart=/bin/sh /home/user/stm32/native/run-boot-screen.sh
TimeoutStopSec=3

[Install]
WantedBy=sysinit.target
