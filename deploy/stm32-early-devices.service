[Unit]
Description=Initialize debug appliance core devices before bulk coldplug
DefaultDependencies=no
Wants=systemd-udevd.service systemd-modules-load.service
After=systemd-udevd.service systemd-modules-load.service
Before=systemd-udev-trigger.service NetworkManager.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/sbin/udevadm trigger --action=add --subsystem-match=block --subsystem-match=net --subsystem-match=gpio --subsystem-match=bcm2835-gpiomem --subsystem-match=i2c-dev --settle
TimeoutStartSec=10
RemainAfterExit=yes
