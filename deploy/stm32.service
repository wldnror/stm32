[Unit]
Description=STM32 debug appliance
DefaultDependencies=no
Wants=stm32-boot-screen.service
After=stm32-boot-screen.service systemd-remount-fs.service systemd-modules-load.service
RequiresMountsFor=/home/user/stm32
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=notify
NotifyAccess=main
User=user
WorkingDirectory=/home/user/stm32
ExecStartPre=-+/bin/sh -c 'if [ -e /dev/rtc0 ]; then /sbin/hwclock -s; fi'
ExecStart=/usr/bin/python3 -u /home/user/stm32/main.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
